// core/, the shared rules it runs and contracts/ alone, with Node types and
// nothing else: this check fails if core/ leans on a type only something above
// it brings.
{
  "extends": "./tsconfig.json",
  "include": [
    "core/**/*.js",
    "core/**/*.d.ts",
    "rules/**/*.mjs",
    "contracts/**/*.d.ts"
  ]
}
