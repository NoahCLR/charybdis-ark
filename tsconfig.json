// core/, the shared rules it runs, contracts/ and core's type tests, with Node
// types and nothing else: this check fails if core/ leans on a type only
// something above it brings. The type tests import only core/ and contracts/
// (tests/layering.test.js), so they bring nothing core/ does not have.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "core/**/*.js",
    "core/**/*.d.ts",
    "rules/**/*.mjs",
    "contracts/**/*.d.ts",
    "tests/types/core.ts"
  ]
}
