{
  "name": "charybdis-ark",
  "description": "Live firmware editor for the Charybdis, as a web page: edits the connected keyboard over WebHID.",
  "version": "2026.10.27",
  "private": true,
  "scripts": {
    "check": "sh scripts/check.sh",
    "test": "node --test tests/",
    "keycodes": "node scripts/generate-keycode-catalog.js",
    "probe:live-link": "node scripts/probe-live-link.js",
    "preview": "node scripts/preview.js",
    "build:web": "node scripts/build-web.js",
    "web": "node scripts/build-web.js && node scripts/serve.js dist/web --port 8975",
    "check:site": "node scripts/check-static-site.js dist/web",
    "test:compat": "node scripts/check-compatibility.js",
    "test:browser": "playwright test",
    "pins": "node scripts/check-pins.js",
    "upstream": "node scripts/refresh-upstream.js",
    "agreement": "node scripts/check-agreement.js",
    "typecheck": "tsc -p tsconfig.rules.json && tsc -p tsconfig.foundation.json && tsc -p tsconfig.json && tsc -p tsconfig.shells.json && tsc -p tsconfig.webview.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.developer.json && tsc -p tsconfig.preview.json"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.5",
    "buffer": "6.0.3",
    "esbuild": "0.28.2",
    "node-hid": "^3.4.0",
    "typescript": "7.0.2"
  }
}
